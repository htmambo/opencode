{
  "$schema": "https://opencode.ai/tui.json",

  // 企业环境强调稳定可复现，建议统一主题
  "theme": "opencode",

  "keybinds": {
    "leader": "ctrl+x",

    // 降低误触分享相关动作（仅影响快捷键，不是权限控制）
    "session_share": "none",
    "session_unshare": "none",

    // 组织常见要求：默认不显示用户名
    "username_toggle": "none",

    // 保留中断快捷键，防止长任务失控
    "session_interrupt": "escape"
  },

  // 堆叠 diff 在窄终端/审计录屏中更稳定
  "diff_style": "stacked",

  // 关闭加速度，保持滚动行为一致可预期
  "scroll_acceleration": {
    "enabled": false
  },
  "scroll_speed": 2.5
}
